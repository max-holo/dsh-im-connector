{
    "name":  "im-connector",
    "version":  "0.4.0",
    "description":  "Extensible IM connector: a single MCP passthrough that routes to DingTalk (dws) and WeCom (wecom-cli), with a provider registry ready for Feishu/Discord and more.",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  "./dist/index.js",
                    "./plugin":  "./dist/plugin/index.js"
                },
    "bin":  {
                "im-connector":  "./dist/mcp/server.js"
            },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "scripts": {
      "build": "tsc -p tsconfig.json",
      "build:bundle": "pnpm build && node scripts/build-bundle.mjs",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "test": "vitest run",
      "test:watch": "vitest",
      "mcp": "node dist/mcp/server.js",
      "smoke:mcp": "node scripts/mcp-smoke.mjs",
      "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke:mcp"
    },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "dependencies":  {
                         "@modelcontextprotocol/sdk":  "^1.12.0",
                         "qrcode":  "^1.5.4"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.10.0",
                            "@types/qrcode":  "^1.5.6",
                            "esbuild":  "^0.28.2",
                            "typescript":  "^5.7.0",
                            "vitest":  "^3.0.0"
                        },
    "keywords":  [
                     "im",
                     "mcp",
                     "dingtalk",
                     "wecom",
                     "feishu",
                     "discord",
                     "connector"
                 ],
    "license":  "MIT"
}
