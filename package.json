{
  "name": "im-connector",
  "version": "1.4.1",
  "description": "MCP server that lets agents drive DingTalk (dws) and WeCom (wecom-cli) CLIs: send messages, write reports, create todos, query calendars and approvals. Ships MCP resources, server instructions, structured tool output, and an inline QR login row for the DSH Web UI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./host": "./dist/host.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./mcp-bundle/locale/*.json",
    "./icon": "./mcp-bundle/icon.svg"
  },
  "bin": {
    "im-connector": "dist/mcp/server.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./mcp-bundle/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    }
  },
  "files": [
    "dist",
    "lib",
    "mcp-bundle",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node dist/mcp/server.js",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke:mcp",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run smoke:mcp"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@wecom/cli": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "mcp-resources",
    "im",
    "dingtalk",
    "dws",
    "wecom",
    "wecom-cli",
    "connector",
    "agent",
    "feishu",
    "discord"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
