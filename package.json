{
  "name": "im-connector",
  "version": "1.0.0",
  "description": "MCP server that lets agents drive DingTalk (dws) and WeCom (wecom-cli) CLIs: send messages, write reports, create todos, query calendars and approvals. Extensible provider registry for more IM platforms.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./mcp-bundle/locale/*.json",
    "./icon": "./mcp-bundle/icon.svg"
  },
  "bin": {
    "im-connector": "dist/mcp/server.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./mcp-bundle/cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "mcp-bundle",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node dist/mcp/server.js",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke:mcp",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run smoke:mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "im",
    "dingtalk",
    "dws",
    "wecom",
    "wecom-cli",
    "connector",
    "agent",
    "feishu",
    "discord"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
