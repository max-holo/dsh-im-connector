{
  "name": "dingtalk-connector",
  "version": "0.2.0",
  "description": "DingTalk read-only connector built on dingtalk-workspace-cli (dws): messages, calendar, todo, approval, attendance, reports, docs/wiki. Ships a TypeScript SDK, an MCP server and a CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dtconn": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node dist/mcp/server.js",
    "listen": "node dist/cli.js listen",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke:mcp"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "dingtalk",
    "connector",
    "mcp",
    "dws",
    "calendar",
    "todo",
    "approval",
    "attendance",
    "report",
    "docs"
  ],
  "license": "MIT"
}
